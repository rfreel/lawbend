{
  "schema_version": 1,
  "control_root": "SYSTEM.md",
  "intent": "INTENT.md",
  "model": "MODEL.md",
  "decisions": "DECISIONS.md",
  "roadmap": "ROADMAP.md",
  "task_template": ".agents/TASK_TEMPLATE.md",
  "claims_registry": ".agents/CLAIMS.json",
  "receipt_tool": ".agents/bin/gate-receipt.sh",
  "toolchains": {"keccak": "bend 2.0.16", "task_machine_and_initializer": "bend 2.0.27"},
  "commands": {
    "bend_version": "bend version",
    "bend_guide": "bend guide",
    "object_proof": "bend PROOF.bend",
    "claim_explain": ".agents/bin/gate-receipt.sh explain CLAIM",
    "claim_hash": ".agents/bin/gate-receipt.sh hash CLAIM",
    "receipt_status": ".agents/bin/gate-receipt.sh status CLAIM RECEIPT EXPECTED_TOOL EXPECTED_CONTEXT",
    "initializer": ".agents/bin/bend-proof-init.sh NEW_DIRECTORY",
    "task_machine_proof": "bend agent-machine/PROOF.bend",
    "task_machine_runtime": "bend agent-machine/TESTS.bend"
  },
  "artifacts": {
    "LAW.bend": {"role": "meta_law", "owner": "human", "agent_edit": false, "anchor": "LAW.IMMUTABLE"},
    "LAWS.bend": {"role": "keccak_laws", "owner": "human", "agent_edit": "explicit_requirements_change_only"},
    "agent-machine/LAWS.bend": {"role": "task_machine_laws", "agent_edit": "explicit_requirements_change_only"},
    "PROOF.bend": {"role": "keccak_proof", "agent_edit": true},
    "benchmarks/research_contract.json": {"role": "experiment_contract", "agent_edit": "explicit_new_experiment_only"},
    ".agents/CLAIMS.json": {"role": "claim_dependency_registry", "agent_edit": true},
    "CORRECTNESS.md": {"role": "keccak_claim_boundary", "agent_edit": true},
    "AFTER_ACTION_REPORT.md": {"role": "history", "default_read": false}
  },
  "paths": {
    "intent": {"read": ["INTENT.md", "MODEL.md"], "first_gate": "H"},
    "proof": {"read": ["LAWS.bend", "PROOF.bend"], "follow_imports": true, "first_gate": "F"},
    "implementation": {"read": ["INTENT.md", "package.bend", "keccak.bend", "LAWS.bend"], "follow_imports": true, "first_gate": "O"},
    "correctness": {"read": ["CORRECTNESS.md", ".agents/CLAIMS.json", "evidence/README.md"], "first_gate": "X"},
    "performance": {"read": ["benchmarks/OPTIMIZATION.md", "benchmarks/research_contract.json"], "first_gate": "P"},
    "research": {"read": [".agents/skills/bend-build/references/research-loops.md", "benchmarks/research_contract.json"], "first_gate": "X"},
    "debugging": {"read": ["agent-machine/DIAGNOSTICS.md"], "input": "exact failing command, source revision and diagnostic", "first_gate": "smallest_discriminator"},
    "release": {"read": ["INTENT.md", "CORRECTNESS.md", ".agents/CLAIMS.json", "LAW.IMMUTABLE"], "first_gate": "V"},
    "tooling": {"read": ["AGENTS.md", ".agents/skills/bend2-official-workflow/SKILL.md"], "first_gate": "approved_executor"},
    "task_machine": {"read": ["agent-machine/README.md", "agent-machine/LAWS.bend", "agent-machine/MACHINE.bend"], "first_gate": "F"},
    "initializer": {"read": ["templates/bend-proof/AGENTS.md", "templates/bend-proof/TRUST.md", ".agents/bin/bend-proof-init.sh"], "first_gate": "O"}
  },
  "gate_classes": {"H": "intent/authority", "M": "model", "F": "formal", "X": "external_empirical", "O": "operational", "P": "performance", "V": "provenance", "A": "acceptance"},
  "accretion": {"durable": "DECISIONS.md", "historical": "AFTER_ACTION_REPORT.md", "bend_diagnostics": "agent-machine/DIAGNOSTICS.md"}
}
